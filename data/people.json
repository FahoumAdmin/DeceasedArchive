[
  {
    "serialNumber": "000001",
    "fullName": "يوسف محمد علي الفاهوم",
    "birthDate": "1904",
    "burialDate": "1969-04-07",
    "location": "חלקה א, שורה 4, קבר 18",
    "generalInfo": "هو سياسي فلسطيني، ورئيس بلدية الناصرة خلال نكبة عام 1948، عُرف بدوره البارز في حماية المدينة من التهجير والدمار، من خلال قيادته لمفاوضات مع القوات الإسرائيلية أفضت إلى توقيع اتفاقية سلمية حافظت على المدينة وسكانها."
  },
  {
    "serialNumber": "000002",
    "fullName": "وليد ابراهيم الفاهوم",
    "birthDate": "1943-02-21",
    "burialDate": "2025-12-14",
    "location": "חלקה ג, שורה 2, קבר 7",
    "generalInfo": " محامي وباحث وكاتب فلسطيني من مواليد مدينة الناصرة عام 1943، درس فاهوم في مدرسة الفرير وفي المدرسة الثانوية للبلدية في الناصرة، حصل على شهادة البكلوريوس في الفلسفة وعلم النفس من الجامعة العبرية في القدس، وفي عام 1974 حصل على إجازة الحقوق، نشط اجتماعيًا وثقافيًا، وانخرط في المؤسسات الوطنية بشكل خاص، ساهم في تأسيس اتحاد جمعيات العمل التطوعي في الناصرة."
  },
  {
    "serialNumber": "000003",
    "fullName": "زهير عبد المجيد الفاهوم",
    "birthDate": "1935-02-20",
    "burialDate": "2009-07-28",
    "location": "חלקה ב, שורה 8, קבר 12",
    "generalInfo": "بدأ مسيرته العمليّة في الخمسينات من القرن العشرين، فكان مُدرِّسًا للغة العربيّة، وتنقَّل بين عدد من القرى والمدن العربية في إسرائيل، فدرّس في حيفا، وإبطن، وبئر المكسور، واستقرّ به المطاف مُدرِّسًا في مدرسة ابن خلدون الإعدادية في مدينة الناصرة، ثمّ ترقّى فأصبح مديرًا للمدرسة عام 1975، وظلّ في منصبه إلى أن خرج للتقاعد عام 1995."
  },
  {
    "serialNumber": "000004",
    "fullName": "ماجد محمد علي الفاهوم",
    "birthDate": "1914-03-18",
    "burialDate": "1973",
    "location": "חלקה ב, שורה 8, קבר 12",
    "generalInfo": "شغل في فترته العديد من المواقع والمناصب الحساسة في مدينة الناصرة، فقد تم انتخابه في اول انتخابات بلدية، بعد قيام الدولة عام 1954، عضوا في السلطة المحلية بالناصرة وبقي في عضوية البلدية حتى عام 1959، كما عمل مدرسا وبعدها شغل منصب مدير المدرسة الثانوية البلدية في الناصرة. بعد ادارة المدرسة الثانوية استلم الاستاذ ماجد منصب مدير لقسم المعارف في بلدية الناصرة . تلقى دراسته الابتدائية وبعدها الثانوية في مدينته، وواصل دراسته في الكلية العربي بالقدس، ليحصل منها على الاجازة الثانية في التدريس. ومما يذكر له بكثير من التقدير، انه عمل على مساعدة العائلات المستورة."
  },
